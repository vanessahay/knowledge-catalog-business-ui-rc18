# Frontend Environment Configuration (.env)
# Copy this file to .env in the project root for local development:
#   cp .env.example .env

VITE_API_URL="http://localhost:3000/api"
VITE_API_VERSION="v1"
VITE_ADMIN_EMAIL="admin@example.com"
VITE_GOOGLE_PROJECT_ID="your-gcp-project-id"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
VITE_GOOGLE_REDIRECT_URI="http://localhost:5173"
VITE_IS_SERVICE_ACCOUNT="false"
VITE_FEATURE_REQUEST_ACCESS="false"
