# Backend Environment Configuration (backend/.env.test)
# Copy this file to backend/.env.test for local development:
#   cp backend/.env.example backend/.env.test

GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GCP_LOCATION=global
GCP_REGION=global
IS_SERVICE_ACCOUNT=false
PORT=3000

# Opcionais (recomendados fora do ambiente local):
# GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"  # aceita só tokens deste OAuth Client
# ALLOWED_EMAIL_DOMAINS="suaempresa.com.br"                                        # restringe quem pode usar o aplicativo
